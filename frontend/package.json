{
  "name": "serveme-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . && i18next-cli lint && yarn lint:i18n-check",
    "lint:i18n": "i18next-cli lint",
    "lint:i18n-check": "node -e \"const fs = require('fs'); const path = require('path'); function checkFile(filePath) { const content = fs.readFileSync(filePath, 'utf8'); if (content.includes('NEEDS_TRANSLATIONS')) { console.error('Found NEEDS_TRANSLATIONS in ' + filePath); process.exit(1); } } checkFile('src/i18n/locales/en/translation.json'); console.log('✅ No NEEDS_TRANSLATIONS found in translation files');\"",
    "i18n:status": "i18next-cli status",
    "i18n:extract": "i18next-cli extract",
    "preview": "vite preview",
    "generate": "orval",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\""
  },
  "dependencies": {
    "@mantine/core": "^8.3.13",
    "@mantine/dates": "^8.3.13",
    "@mantine/form": "^8.3.13",
    "@mantine/hooks": "^8.3.13",
    "@mantine/modals": "^8.3.13",
    "@mantine/notifications": "^8.3.13",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "^5.90.19",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.27.5",
    "i18next": "^25.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^7.12.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "i18next-cli": "^1.37.1",
    "orval": "^8.0.2",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1"
  },
  "packageManager": "yarn@4.0.2"
}
